{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperPlane Custom Automation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "triggers", "steps"],
  "properties": {
    "apiVersion": { "const": "v2" },
    "kind": { "const": "Automation" },
    "name": { "$ref": "#/$defs/nonblank" },
    "icon": {
      "default": "sparkles",
      "enum": [
        "sparkles", "shield-check", "search", "bug", "file-code", "code", "terminal",
        "eye", "gauge", "git-pull-request", "cpu", "circle-check", "activity", "alarm-clock",
        "archive", "bell", "bolt", "book", "box", "boxes", "braces", "calendar", "camera",
        "chart-line", "check", "clock", "cloud", "cog", "component", "container", "database",
        "factory", "file-json", "file-text", "fingerprint", "flag", "folder", "git-branch",
        "git-commit", "git-merge", "globe", "key", "layers", "lock", "message-square",
        "network", "package", "rocket"
      ]
    },
    "timeout": { "$ref": "#/$defs/nonblank", "description": "A duration from 0s through 24h in whole seconds. Zero uses the default." },
    "run_context": { "enum": ["task", "workspace"] },
    "agent": { "$ref": "#/$defs/agent" },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trigger" },
      "allOf": [
        { "contains": { "type": "object", "required": ["uses"], "properties": { "uses": { "const": "manual" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["uses"], "properties": { "uses": { "const": "task_enters_stage" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["uses"], "properties": { "uses": { "const": "task_leaves_stage" } } }, "minContains": 0, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["uses"], "properties": { "uses": { "const": "pull_request_updated" } } }, "minContains": 0, "maxContains": 1 }
      ]
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "nonblank": { "type": "string", "pattern": "[^\u0009-\u000d \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uses"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank",
          "description": "Use a unique ID within the automation."
        },
        "uses": { "enum": ["manual", "task_enters_stage", "task_leaves_stage", "pull_request_updated", "schedule", "webhook"] },
        "config": true
      },
      "if": { "$ref": "#/$defs/isSchedule" },
      "then": { "required": ["config"], "properties": { "config": { "$ref": "#/$defs/schedule" } } },
      "else": {
        "if": { "$ref": "#/$defs/isWebhook" },
        "then": { "required": ["config"], "properties": { "config": { "$ref": "#/$defs/webhook" } } },
        "else": { "properties": { "config": false } }
      }
    },
    "isSchedule": { "type": "object", "properties": { "uses": { "const": "schedule" } }, "required": ["uses"] },
    "isWebhook": { "type": "object", "properties": { "uses": { "const": "webhook" } }, "required": ["uses"] },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webhook_id"],
      "properties": {
        "webhook_id": {
          "$ref": "#/$defs/nonblank",
          "description": "Use the ID of a webhook from the workspace settings."
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cron"],
      "properties": {
        "cron": {
          "$ref": "#/$defs/nonblank",
          "description": "Use five cron fields, or six with seconds first."
        },
        "timezone": { "$ref": "#/$defs/nonblank", "description": "A UTC offset in hours, from -12 through 14." }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonblank" },
        "bash": { "$ref": "#/$defs/nonblank" },
        "working_directory": { "$ref": "#/$defs/nonblank" },
        "prompt": { "$ref": "#/$defs/nonblank" },
        "secrets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonblank" } }
      },
      "if": { "required": ["bash"] },
      "then": { "properties": { "prompt": false } },
      "else": { "required": ["prompt"], "properties": { "secrets": false } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "credentials": ["harness"] },
      "properties": {
        "harness": { "enum": ["superplane", "claude-code", "codex", "openrouter"] },
        "model": { "$ref": "#/$defs/nonblank" },
        "credentials": { "$ref": "#/$defs/credentials" },
        "additional_instructions": { "type": "string" },
        "thinking_level": { "$ref": "#/$defs/nonblank" },
        "timeout": { "$ref": "#/$defs/nonblank" },
        "skip_repository_checkout": { "type": "boolean" },
        "skip_setup_commands": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["harness"], "properties": { "harness": { "const": "superplane" } } },
          "then": { "properties": { "credentials": false } }
        },
        {
          "if": {
            "required": ["credentials"],
            "properties": {
              "credentials": { "type": "object", "required": ["source"], "properties": { "source": { "const": "subscription" } } }
            }
          },
          "then": {
            "properties": { "harness": { "const": "codex" } }
          }
        }
      ]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["integration", "subscription", "hosted"] },
        "name": { "$ref": "#/$defs/nonblank" }
      },
      "if": { "properties": { "source": { "const": "integration" } } },
      "then": { "required": ["name"] },
      "else": { "properties": { "name": false } }
    }
  }
}
