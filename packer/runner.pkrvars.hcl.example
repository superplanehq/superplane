# Packer variables for local dev / manual builds.
# Copy this to runner.pkrvars.hcl and fill in values.
# In CI these are passed via -var flags.

aws_region          = "us-east-1"
runner_s3_uri_amd64 = "s3://superplane-runner/latest/runner-linux-amd64"
runner_s3_uri_arm64 = "s3://superplane-runner/latest/runner-linux-arm64"
