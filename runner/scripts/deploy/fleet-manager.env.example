# Optional environment variables for the fleet-manager container/process.
# Pool configuration (broker URL, AMIs, subnets, …) lives in the JSON config
# file mounted at FM_CONFIG_FILE — not here.
#
# FM_CONFIG_FILE=/etc/fleet-manager/config.json

# OpenTelemetry metrics export (Dash0 gRPC). Omit OTEL_EXPORTER_OTLP_ENDPOINT to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer CHANGEME
OTEL_SERVICE_NAME=fleet-manager
