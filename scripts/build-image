#!/usr/bin/env bash
# Compile once using the mounted CI caches, then package the runtime artifacts.
# Main publishes CDN and same-origin variants. Other refs only build an image.
set -euo pipefail

cd "$(dirname "$0")/.."

ASSET_CDN_ORIGIN="https://assets.superplane.com"
mkdir -p tmp
build_dir="$(mktemp -d tmp/image-build.XXXXXX)"
context="${build_dir}/context"
upload_pid=""

cleanup() {
  if [[ -n "$upload_pid" ]]; then
    kill "$upload_pid" 2>/dev/null || true
    wait "$upload_pid" 2>/dev/null || true
  fi
  rm -rf "$build_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

is_main_branch_push() {
  [[ "${SEMAPHORE_GIT_REF_TYPE:-}" == "branch" && "${SEMAPHORE_GIT_BRANCH:-}" == "main" ]]
}

compose_exec() {
  local files=(-f docker-compose.dev.yml)
  if [[ -n "${CI:-}" ]]; then
    files+=(-f docker-compose.ci.yml)
  fi
  docker compose "${files[@]}" exec -T "$@"
}

prepare_artifacts() {
  make image.prepare IMAGE_BUILD_DIR="$context"
  mkdir -p "$context/app/db" "$context/app/api" "$context/app/ee" "$context/scripts/docker"
  cp LICENSE NOTICE docker-entrypoint.sh "$context/app/"
  cp ee/LICENSE "$context/app/ee/"
  cp -R db/migrations db/data_migrations "$context/app/db/"
  cp -R api/swagger "$context/app/api/"
  cp -R rbac templates "$context/app/"
  cp scripts/docker/install-postgresql-client.sh "$context/scripts/docker/"
}

build_frontend() {
  local variant="$1"
  local asset_base_url="$2"

  echo "Building ${variant} frontend"
  mkdir -p "${build_dir}/${variant}"
  compose_exec -e VITE_BASE_URL="${BASE_URL:-https://app.superplane.com}" \
    -e VITE_ASSET_BASE_URL="$asset_base_url" app bash /app/scripts/with-host-owned-output \
    "/app/${build_dir}/${variant}" bash -lc \
    "cd web_src && NODE_OPTIONS=--max-old-space-size=4096 npx vite build --outDir '/app/${build_dir}/${variant}'"
}

package_image() {
  local image_tag="$1"
  local variant="$2"

  mkdir -p "$context/app/pkg/web/assets"
  rm -rf "$context/app/pkg/web/assets/dist"
  cp -R "${build_dir}/${variant}" "$context/app/pkg/web/assets/dist"
  make image.package IMAGE_TAG="$image_tag" IMAGE_BUILD_DIR="$context"
}

publish_main_images() {
  local image_tag="$1"
  local asset_base_url="${ASSET_CDN_ORIGIN}/releases/${image_tag}/"

  build_frontend hosted "$asset_base_url"
  # Keep this directory immutable until the upload completes. Packaging and
  # the same-origin frontend build can proceed while R2 receives these assets.
  GIT_SHA="$image_tag" R2_ASSET_BASE_URL="$asset_base_url" \
    DIST_DIR="${build_dir}/hosted" bash scripts/upload-static-assets-r2 &
  upload_pid=$!

  package_image "$image_tag" hosted
  build_frontend selfhosted ""
  package_image "${image_tag}-selfhosted" selfhosted

  # Do not publish either image if its CDN assets failed to upload.
  wait "$upload_pid"
  upload_pid=""
  make image.auth
  make image.push IMAGE_TAG="$image_tag"
  make image.push IMAGE_TAG="${image_tag}-selfhosted"
}

prepare_artifacts
image_tag="$(git rev-list -1 HEAD -- .)"
if is_main_branch_push; then
  publish_main_images "$image_tag"
  exit 0
fi

build_frontend selfhosted ""
package_image "$image_tag" selfhosted
