# Optional overrides for docker --env-file or systemd EnvironmentFile= on the worker host.
# Copy to runner.env and adjust; do not commit secrets.

# Required: task-broker base URL (http:// or https:// — same origin is used for WebSocket).
# TASK_BROKER_URL=http://127.0.0.1:8081

# Architecture routing happens at task-broker by registering separate fleets with labels
# such as arch:amd64 and arch:arm64; this runner only joins the fleet id named below.

# Required: fleet id this runner claims tasks for (registered via POST /v1/fleets on the broker).
# RUNNER_FLEET_ID=local

# If task-broker sets AUTH_TOKEN, set the same value here.
# AUTH_TOKEN=CHANGEME

# Optional; defaults to hostname or a generated id.
# RUNNER_ID=i-0123456789abcdef0

# Health probe for fleet-manager EC2 reconcile (default 0.0.0.0:9090).
# RUNNER_HEALTH_ADDR=0.0.0.0:9090

# Transport: default is WebSocket (GET /v1/runners/stream).
# RUNNER_TRANSPORT=http

# POLL_EMPTY_MS=1000

# EC2 disposable runners: exit after one successful task.
# RUNNER_TERMINATE_AFTER_EACH_TASK=1
