# Optional overrides for docker --env-file or systemd EnvironmentFile= on the worker host.
# Copy to runner.env and adjust; do not commit secrets.

# Required: this fleet’s fleet-manager base URL (http:// or https:// — same origin is used for WebSocket).
# FLEET_MANAGER_URL=http://127.0.0.1:8080

# If fleet-manager sets AUTH_TOKEN, set the same value here.
# AUTH_TOKEN=CHANGEME

# Optional; defaults to hostname or a generated id.
# RUNNER_ID=i-0123456789abcdef0

# Transport: default is WebSocket (GET /v1/runners/stream on the same host as FLEET_MANAGER_URL).
# Use HTTP claim/complete only for debugging or older fleet-manager without the stream route:
# RUNNER_TRANSPORT=http

# Optional: sleep when no work (HTTP transport only; ignored for meaningful WS idle behavior).
# POLL_EMPTY_MS=1000

# EC2 disposable runners: exit after one successful task when fleet-manager will terminate the VM.
# RUNNER_TERMINATE_AFTER_EACH_TASK=1
