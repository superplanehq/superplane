# aws-vault exec PROFILE -- docker …  # or IAM instance profile on the fleet-manager host (no keys here).
AWS_REGION=us-east-1

# Desired pending+running instances tagged superplane_managed_runner (0 drains managed runners).
EC2_PROVISION_HOT_INSTANCE_COUNT=5

# Replace after: aws ec2 describe-subnets …  describe-security-groups …
EC2_PROVISION_AMI_ID=ami-CHANGEME
EC2_PROVISION_SUBNET_ID=subnet-CHANGEME
EC2_PROVISION_SECURITY_GROUP_IDS=sg-CHANGEME

# Runner instances must reach task-broker from the VPC:
# EC2_PROVISION_TASK_BROKER_URL=http://broker.internal:8081
EC2_PROVISION_TASK_BROKER_URL=http://98.91.210.215:8081

# Fleet id registered on task-broker (POST /v1/fleets) — must match RUNNER_FLEET_ID in user-data.
EC2_PROVISION_RUNNER_FLEET_ID=aws-standard-1

EC2_PROVISION_INSTANCE_TYPE=t3.micro

# Runner binary in S3; EC2_PROVISION_RUNNER_INSTANCE_PROFILE required (role: s3:GetObject on that ARN).
EC2_PROVISION_RUNNER_S3_URI=s3://YOUR_BUCKET/path/runner-linux-amd64

EC2_PROVISION_RECONCILE_INTERVAL_SEC=60
# EC2_PROVISION_BOOT_GRACE_SEC=300
# EC2_PROVISION_RUNNER_HEALTH_PORT=9090

# If task-broker AUTH_TOKEN is set, set the same token so runners authenticate.
EC2_PROVISION_RUNNER_AUTH_TOKEN=CHANGEME_SAME_AS_BROKER_AUTH_TOKEN

EC2_PROVISION_RUNNER_INSTANCE_PROFILE=YOUR_INSTANCE_PROFILE_WITH_S3_READ

# Default true: runner exits after one task; fleet-manager terminates VM when /healthz fails after grace.
# EC2_PROVISION_RUNNER_TERMINATE_AFTER_TASK=true

# Optional: Bearer for GET /v1/admin/managed-runners and GET /v1/admin/ec2-console-output (boot logs).
# FLEET_DIAGNOSTICS_TOKEN=
