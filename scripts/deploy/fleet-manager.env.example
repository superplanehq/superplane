# aws-vault exec PROFILE -- docker …  # or IAM instance profile on the fleet-manager host (no keys here).
AWS_REGION=us-east-1

# Desired pending+running instances tagged superplane_managed_runner (0 drains managed runners).
EC2_PROVISION_HOT_INSTANCE_COUNT=2

# Replace after: aws ec2 describe-subnets …  describe-security-groups …
# Canonical Ubuntu 22.04 AMI (varies per region): see AWS console or EC2 “Launch instances” AMI picker.
EC2_PROVISION_AMI_ID=ami-CHANGEME
EC2_PROVISION_SUBNET_ID=subnet-CHANGEME
EC2_PROVISION_SECURITY_GROUP_IDS=sg-CHANGEME

# Runner instances must reach this URL; use the fleet-manager container’s reachable address:
# · same VPC/private subnet runners → http://PRIVATE_IP_OR_PRIVATE_DNS:8080
# · public/demo → http://13.220.51.216:8080  (adjust to your LISTEN_HOST:HOST_PORT mapping)
EC2_PROVISION_FLEET_MANAGER_URL=http://13.220.51.216:8080

EC2_PROVISION_INSTANCE_TYPE=t3.micro
EC2_PROVISION_RUNNER_IMAGE=ghcr.io/superplanehq/runner/runner:latest
EC2_PROVISION_RECONCILE_INTERVAL_SEC=60

# Key pair on the instances (optional; distroless/debug only).
# EC2_PROVISION_KEY_NAME=my-keypair

# If fleet-manager AUTH_TOKEN is set when you deploy, set the same token so runners authenticate.
EC2_PROVISION_RUNNER_AUTH_TOKEN=CHANGEME_SAME_AS_FLEET_AUTH_TOKEN

# Optional IAM instance profile name for runner VMs (needs ECR/ghcr pull policies if applicable).
# EC2_PROVISION_RUNNER_INSTANCE_PROFILE=superplane-runner-profile
#
# Default true: fleet-manager TerminateInstances each runner EC2 VM after one task (hot pool reconciles replacements).
# Set false for long-lived runner containers on EC2.
# EC2_PROVISION_RUNNER_TERMINATE_AFTER_TASK=true
#
# fleet-manager IAM needs ec2:TerminateInstances; runner instance profile does not.

REAP_INTERVAL_SEC=15
