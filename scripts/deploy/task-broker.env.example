# Optional overrides for docker --env-file. The start script can pass AUTH_TOKEN from the shell.
#
# Required: PostgreSQL connection string (RDS, managed Postgres, or self-hosted).
# DATABASE_URL=postgres://broker:CHANGEME@db.example.com:5432/broker?sslmode=require

# Required: Broker refuses to start without AUTH_TOKEN. Clients use Authorization: Bearer <this value> for /v1.
# AUTH_TOKEN=CHANGEME

# LISTEN_ADDR=:8081
# REAP_INTERVAL_SEC=15
# TASK_CLOUDWATCH_LOG_GROUP=
# TASK_CLOUDWATCH_LOG_STREAM_PREFIX=
# TASK_CLOUDWATCH_REGION=
