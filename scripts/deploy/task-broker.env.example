# Optional overrides for docker --env-file. The start script already sets:
#   BROKER_PUBLIC_URL=http://YOUR_BROKER_HOST:HOST_PORT (default broker EC2 shown below if you use script defaults)
#   AUTH_TOKEN from the shell when you run start-task-broker-remote.sh
#
# Override public URL here only if you want it in the file instead of the script env:
# BROKER_PUBLIC_URL=http://98.91.210.215:8081

# Must match the fleet id used in POST /v1/fleets (SuperPlane Runner default):
# TASK_BROKER_FLEET_ID=aws-standard-1

# Bearer for /v1 when broker AUTH_TOKEN is set (must match superplane defaultBrokerAuthToken):
# AUTH_TOKEN=

# LISTEN_ADDR=:8081
# DATABASE_PATH=/home/nonroot/broker.db
