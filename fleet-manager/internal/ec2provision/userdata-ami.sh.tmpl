#!/bin/bash
# userdata-ami.sh.tmpl — used when instances are launched from a pre-baked SuperPlane runner AMI.
# All packages, the runner binary, the systemd unit, and the CW agent are already installed.
# This script only writes the per-instance EnvironmentFile and starts the service.
set -euxo pipefail

#########################################################
# Instance identity
#########################################################

INSTANCE_METADATA_URL=http://169.254.169.254
METADATA_TOKEN=$(curl -sf --max-time 3 "$INSTANCE_METADATA_URL/latest/api/token" \
  -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
INSTANCE_ID=$(curl -sf --max-time 3 \
  -H "X-aws-ec2-metadata-token: $METADATA_TOKEN" \
  "$INSTANCE_METADATA_URL/latest/meta-data/instance-id")

#########################################################
# Runner binary (installed at launch, not baked into the AMI)
#########################################################

export AWS_DEFAULT_REGION={{shellQuote .RunnerInstallAWSRegion}}
RUNNER_S3_URI={{shellQuote .RunnerS3URI}}

aws s3 cp "$RUNNER_S3_URI" /usr/local/bin/runner
chmod 755 /usr/local/bin/runner

#########################################################
# Per-instance environment
#########################################################

cat > /etc/default/superplane-runner <<ENVEOF
TASK_BROKER_URL={{shellQuote .TaskBrokerURL}}
RUNNER_FLEET_ID={{shellQuote .RunnerFleetID}}
RUNNER_ID=${INSTANCE_ID}
RUNNER_SHELL=/bin/bash
RUNNER_HEALTH_ADDR=0.0.0.0:9090
AUTH_TOKEN={{shellQuote .RunnersAuthToken}}
RUNNER_TERMINATE_AFTER_EACH_TASK={{.RunnerTerminateAfterEachTask}}
RUNNER_CLOUDWATCH_LOG_GROUP={{shellQuote .RunnerCloudWatchLogGroup}}
RUNNER_CLOUDWATCH_REGION={{shellQuote .RunnerInstallAWSRegion}}
RUNNER_CLOUDWATCH_LOG_STREAM_PREFIX={{shellQuote .RunnerCloudWatchLogStreamPrefix}}
{{- if .LaunchRequestedAt}}
RUNNER_LAUNCH_REQUESTED_AT={{.LaunchRequestedAt}}
{{- end}}
ENVEOF

chmod 644 /etc/default/superplane-runner

#########################################################
# CloudWatch agent — apply config (agent is pre-installed in the AMI)
#########################################################

{{- if .CloudWatchAgentJSON}}
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWEOF'
{{.CloudWatchAgentJSON}}
CWEOF

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s
{{- end}}

#########################################################
# Start the runner (unit is already installed + enabled in the AMI)
#########################################################

systemctl daemon-reload
systemctl start superplane-runner.service
