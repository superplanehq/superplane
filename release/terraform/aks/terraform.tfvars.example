# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

subscription_id = "00000000-0000-0000-0000-000000000000"

# Domain name for SuperPlane
domain_name = "superplane.example.com"

# Email for Let's Encrypt certificate notifications
letsencrypt_email = "admin@example.com"

# -----------------------------------------------------------------------------
# SuperPlane
# -----------------------------------------------------------------------------

# Empty image tag uses the chart appVersion (for example v1.0.0-rc3).
# superplane_image_tag = ""
# image_registry = "ghcr.io/superplanehq"
# superplane_chart_version = "1.0.0-rc3"
# cert_manager_chart_version  = "v1.21.2"
# ingress_nginx_chart_version = "4.15.1"
#
# Local chart and images. See README, "Development: local images and chart".
# helm_chart_path = "../../superplane-helm-chart/helm"
# superplane_image_tag = "local-<git-sha>"
# image_registry = "myregistry.azurecr.io"
# container_registry_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/superplane-images/providers/Microsoft.ContainerRegistry/registries/myregistry"
# superplane_namespace = "superplane"

# After owner setup, use /admin/fleet-manager-setup. The page maps Terraform
# outputs to the standalone chart at
# oci://ghcr.io/superplanehq/fleet-manager-chart.

# -----------------------------------------------------------------------------
# Optional Variables - Azure Region
# -----------------------------------------------------------------------------

# location            = "eastus"
# resource_group_name = "superplane"

# -----------------------------------------------------------------------------
# Optional Variables - AKS Cluster
# -----------------------------------------------------------------------------

# cluster_name        = "superplane"
# kubernetes_version  = ""
# node_count          = 1
# node_vm_size        = "Standard_D2s_v4"

# -----------------------------------------------------------------------------
# Optional Variables - PostgreSQL
# -----------------------------------------------------------------------------

# Set false when `az postgres flexible-server list-skus --location eastus` is empty.
# create_postgresql_flexible_server = false

# db_server_name   = "superplane-db"
# db_engine_version = "16"
# db_sku_name      = "B_Standard_B2s"
# db_storage_mb    = 32768
# db_name          = "superplane"
# db_username      = "superplane"

# Optionally provide a database password (otherwise one will be generated)
# db_password = "your-secure-password"

# -----------------------------------------------------------------------------
# Optional Variables - Network
# -----------------------------------------------------------------------------

# vnet_cidr             = "10.0.0.0/16"
# aks_subnet_cidr       = "10.0.0.0/20"
# postgres_subnet_cidr  = "10.0.16.0/24"
# runner_subnet_cidr    = "10.0.17.0/24"
# runner_zones          = ["1", "2"]
# The defaults already use the public community gallery images.
# runner_image_amd64 = "/CommunityGalleries/Superplane-ba852f02-dd01-43eb-b8c4-67a57fdd8af8/Images/superplane-runner-amd64/Versions/1.14623.0"
# runner_image_arm64 = "/CommunityGalleries/Superplane-ba852f02-dd01-43eb-b8c4-67a57fdd8af8/Images/superplane-runner-arm64/Versions/1.14623.0"
# A customer gallery version ID from the development Packer path also works.
# runner_image_amd64 = "/subscriptions/.../galleries/.../images/runner-amd64/versions/1.0.0"
# runner_image_arm64 = "/subscriptions/.../galleries/.../images/runner-arm64/versions/1.0.0"
# aks_service_cidr      = "172.16.0.0/16"
# aks_dns_service_ip    = "172.16.0.10"
