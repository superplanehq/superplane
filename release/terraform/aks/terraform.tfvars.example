# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

subscription_id = "00000000-0000-0000-0000-000000000000"

# Domain name for SuperPlane
domain_name = "superplane.example.com"

# Email for Let's Encrypt certificate notifications
letsencrypt_email = "admin@example.com"

# -----------------------------------------------------------------------------
# SuperPlane
# -----------------------------------------------------------------------------

# superplane_image_tag = "stable"  # Options: stable, beta, or specific version like v0.4
# image_registry = "ghcr.io/superplanehq"
# Use an ACR login server for images you build in this repository:
# image_registry = "myregistry.azurecr.io"
# container_registry_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/superplane-images/providers/Microsoft.ContainerRegistry/registries/myregistry"
# helm_chart_path = "../../superplane-helm-chart/helm"
# superplane_namespace = "superplane"

# Set a Fleet Manager YAML body to start the Deployment.
# fleet_manager_config = <<EOF
# id: aks
# superplaneUrl: https://superplane.example.com
# installationAdminToken: replace-me
# runnerReleaseBaseUrl: https://downloads.example/runner
# fleets:
#   - id: linux-amd64
#     provider: azure
#     warmCapacity: 1
#     maxCapacity: 10
#     azure:
#       subscriptionId: 00000000-0000-0000-0000-000000000000
#       resourceGroup: superplane-runners
#       location: eastus
#       imageId: /subscriptions/.../images/superplane-runner-amd64/versions/1.0.0
#       vmSize: Standard_D2ds_v4
#       architecture: amd64
#       subnetId: /subscriptions/.../subnets/superplane-runners
#       networkSecurityGroupId: /subscriptions/.../networkSecurityGroups/superplane-runners
#       identityId: /subscriptions/.../userAssignedIdentities/superplane-runner
#       zones: ["1", "2"]
#       diskSizeGb: 30
#       ephemeralOSDisk: true
# EOF

# -----------------------------------------------------------------------------
# Optional Variables - Azure Region
# -----------------------------------------------------------------------------

# location            = "eastus"
# resource_group_name = "superplane"

# -----------------------------------------------------------------------------
# Optional Variables - AKS Cluster
# -----------------------------------------------------------------------------

# cluster_name        = "superplane"
# kubernetes_version  = ""
# node_count          = 1
# node_vm_size        = "Standard_D2s_v4"

# -----------------------------------------------------------------------------
# Optional Variables - PostgreSQL
# -----------------------------------------------------------------------------

# Set false when `az postgres flexible-server list-skus --location eastus` is empty.
# create_postgresql_flexible_server = false

# db_server_name   = "superplane-db"
# db_engine_version = "16"
# db_sku_name      = "B_Standard_B2s"
# db_storage_mb    = 32768
# db_name          = "superplane"
# db_username      = "superplane"

# Optionally provide a database password (otherwise one will be generated)
# db_password = "your-secure-password"

# -----------------------------------------------------------------------------
# Optional Variables - Network
# -----------------------------------------------------------------------------

# vnet_cidr             = "10.0.0.0/16"
# aks_subnet_cidr       = "10.0.0.0/20"
# postgres_subnet_cidr  = "10.0.16.0/24"
# runner_subnet_cidr    = "10.0.17.0/24"
# aks_service_cidr      = "172.16.0.0/16"
# aks_dns_service_ip    = "172.16.0.10"
