# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

# Domain name for SuperPlane
domain_name = "superplane.example.com"

# Email for Let's Encrypt certificate notifications
letsencrypt_email = "admin@example.com"

# Packer-built linux/amd64 runner AMI for the default fleet. Build it with
# release/runner/packer/aws/runner.pkr.hcl before the first apply, for example
# ami-0123456789abcdef0. Required when enable_runners is true.
runner_image_amd64 = ""

# -----------------------------------------------------------------------------
# SuperPlane
# -----------------------------------------------------------------------------

# Terraform downloads the chart from
# oci://ghcr.io/superplanehq/superplane-chart. The chart uses the application
# image at ghcr.io/superplanehq/superplane.
# superplane_chart_version = "1.0.0-rc3"
# superplane_image_tag    = ""  # Empty uses the chart's matching image.
# superplane_namespace = "superplane"

# Nominal PV/PVC capacity. EFS grows elastically and does not reserve this size.
# runner_active_log_volume_capacity = "1Gi"

# Create the runner security group, IAM roles, instance profile, and enable the
# integrated Runner API. Install the standalone Fleet Manager chart after owner
# setup with /admin/fleet-manager-setup. Set this to false to install without
# runners.
# enable_runners = true
# runner_image_arm64 = "ami-0fedcba9876543210"

# -----------------------------------------------------------------------------
# Optional Variables - AWS Region
# -----------------------------------------------------------------------------

# region = "us-east-1"

# Availability zones (minimum 2 required by AWS for EKS/RDS)
# availability_zones = ["us-east-1a", "us-east-1b"]

# -----------------------------------------------------------------------------
# Optional Variables - EKS Cluster
# -----------------------------------------------------------------------------

# cluster_name    = "superplane"
# cluster_version = "1.37"
# node_count      = 2
# instance_type   = "t3.medium"

# -----------------------------------------------------------------------------
# Optional Variables - RDS
# -----------------------------------------------------------------------------

# db_instance_identifier = "superplane-db"
# db_engine_version      = "17"
# db_instance_class      = "db.t3.medium"
# db_allocated_storage   = 20
# db_name                = "superplane"
# db_username            = "postgres"

# Set to false and apply before terraform destroy
# rds_deletion_protection = true

# Optionally provide a database password (otherwise one will be generated)
# db_password = "your-secure-password"


# -----------------------------------------------------------------------------
# Optional Variables - Network
# -----------------------------------------------------------------------------

# vpc_cidr = "10.0.0.0/16"
