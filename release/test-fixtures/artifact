#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 3 ] || [ "$2" != "workflow" ]; then
  echo "Usage: artifact <push|pull> workflow <path>" >&2
  exit 1
fi

ACTION="$1"
SOURCE="$3"
# Semaphore keeps the path argument as the artifact name. Prepare and
# publish run on different machines, so an absolute temp path cannot be
# pulled later.
case "${SOURCE}" in
  /* | *..* | */*)
    echo "Error: artifact name must be a stable relative file name: ${SOURCE}" >&2
    exit 1
    ;;
esac
STORED_PATH="${ARTIFACT_TEST_STORE:?}/${SOURCE}"

case "${ACTION}" in
  push)
    if [ -e "${STORED_PATH}" ]; then
      echo "Error: ${SOURCE} already exists" >&2
      exit 1
    fi
    mkdir -p "${ARTIFACT_TEST_STORE}"
    cp "${SOURCE}" "${STORED_PATH}"
    ;;
  pull)
    cp "${STORED_PATH}" "${SOURCE}"
    ;;
  *)
    echo "Error: unsupported artifact action ${ACTION}" >&2
    exit 1
    ;;
esac
