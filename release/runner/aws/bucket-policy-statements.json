[
  {
    "Sid": "DenyInsecureTransport",
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
      "arn:aws:s3:::superplanehq-releases",
      "arn:aws:s3:::superplanehq-releases/*"
    ],
    "Condition": {
      "Bool": {
        "aws:SecureTransport": "false"
      }
    }
  },
  {
    "Sid": "DenyRunnerWritesWithoutCreateOnlyCondition",
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::superplanehq-releases/runner/*",
    "Condition": {
      "Null": {
        "s3:if-none-match": "true"
      }
    }
  },
  {
    "Sid": "DenyRunnerWritesWithWrongCreateOnlyCondition",
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::superplanehq-releases/runner/*",
    "Condition": {
      "StringNotEquals": {
        "s3:if-none-match": "*"
      }
    }
  }
]
