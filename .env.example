# Local development overrides.
#
# Copy this file to `.env` and uncomment only the values you want to override.
# Docker Compose automatically reads `.env` in the repo root for variable
# interpolation. It is not a generic env_file, so variables only affect the app
# container when docker-compose.dev.yml explicitly references them.

## Public web/API entrypoint
##
## If you change PUBLIC_API_PORT, keep BASE_URL, WEBHOOKS_BASE_URL, and
## ALLOWED_WS_ORIGINS aligned unless you intentionally need different origins.
## make db.snapshot and make db.restore use this worktree's Compose Postgres
## (db:5432). PUBLIC_API_PORT is the UI port only.
# PUBLIC_API_PORT=8000
# BASE_URL=http://localhost:8000
# WEBHOOKS_BASE_URL=http://host.docker.internal:8000
# ALLOWED_WS_ORIGINS=http://localhost:8000
#
## Process role flags (docker-compose.dev.yml sets these for local single-process).
## START_WEBSOCKET_SERVER: yes|no; unset follows START_WEB_SERVER (compat).
## START_GRPC_GATEWAY: set to no on websocket-only pods; unset/yes keeps REST gateway.
# START_WEBSOCKET_SERVER=yes
# START_GRPC_GATEWAY=yes
## Finished canvas-run retention. The worker starts only when
## START_EVENT_RETENTION_WORKER=yes. It deletes finished runs for
## organizations with usage_retention_window_days > 0 (default 180).
# START_EVENT_RETENTION_WORKER=yes

## App-facing ports
##
## PORT and API_PORT default to PUBLIC_API_PORT. Only set them directly when
## the app server and Vite proxy need to diverge from PUBLIC_API_PORT.
# PORT=8000
# API_PORT=8000
# VITE_DEV_PORT=5173
# VITE_PREVIEW_PORT=4173
# STORYBOOK_PORT=6006

## Supporting service host ports
# PGWEB_PORT=8081
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318

## Performance profiling (Go pprof)
##
## When PPROF_ENABLED=yes the dev server exposes net/http/pprof endpoints at
## http://localhost:${PPROF_PORT}/debug/pprof/ for CPU, heap, goroutine, block,
## and mutex profiles. Defaults to on in the dev compose file; set to anything
## other than "yes" to disable. The endpoint is unauthenticated, so keep it off
## outside local development. See docs/contributing/profiling.md.
# PPROF_ENABLED=yes
# PPROF_PORT=6060

## Database timeout overrides
##
## Values can be Go durations such as 60s/2m or integer milliseconds.
# DB_STATEMENT_TIMEOUT=60s
# DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30s

## Telemetry and frontend feature flags
# SENTRY_ENVIRONMENT=development
# POSTHOG_KEY=
# Set only in SuperPlane Cloud. Empty disables Google Tag Manager.
# GTM_CONTAINER_ID=
# DASH0_WEB_OTLP_ENDPOINT=
# DASH0_WEB_AUTH_TOKEN=
# DASH0_WEB_SERVICE_NAME=superplane-web
# DASH0_WEB_ENVIRONMENT=
## Email and signup
##
## Email consumers are skipped unless RESEND_API_KEY and sender values are set.
# RESEND_API_KEY=
# EMAIL_FROM_NAME=SuperPlane
# EMAIL_FROM_ADDRESS=noreply@notifications.superplane.com
# DISCORD_FEEDBACK_WEBHOOK_URL=
# BLOCK_SIGNUP=yes
# SIGNUP_WAITLIST_MAILERLITE_ACCOUNT_ID=
# SIGNUP_WAITLIST_MAILERLITE_FORM_ID=

## Anthropic managed agents
##
## All three values are required for the agent provider to be enabled.
## The agent UI is gated by the claude_managed_agents experimental feature.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AGENT_ID=
# ANTHROPIC_ENVIRONMENT_ID=

## Local hosted OpenRouter (development only)
##
## Opt-in seed for the SuperPlane-hosted OpenRouter provider. Production
## and other developers leave these empty. Set the flag to yes, add both
## keys, and list model ids. Recreate the app container after you change
## these values. The seed does not call OpenRouter at startup.
# SUPERPLANE_DEV_HOSTED_OPENROUTER=yes
# SUPERPLANE_DEV_OPENROUTER_API_KEY=
# SUPERPLANE_DEV_OPENROUTER_MANAGEMENT_KEY=
# SUPERPLANE_DEV_OPENROUTER_MODELS=openai/gpt-5,anthropic/claude-sonnet-4
# SUPERPLANE_DEV_OPENROUTER_BASE_URL=
# SUPERPLANE_DEV_HOSTED_DEFAULT_MODEL=openai/gpt-5

## Legacy runner task broker
##
## Local development uses the integrated runner API and Docker Fleet Manager.
## Set these values only while an installation still routes tasks to a legacy
## or remote task broker.
## Do not commit real broker tokens. TASK_BROKER_FLEET_ID, when set, is the
## create-task fleet_id. Empty TASK_BROKER_FLEET_ID keeps node machine types.
# TASK_BROKER_BASE_URL=
# TASK_BROKER_PUBLIC_URL=
# TASK_BROKER_FLEET_ID=
# TASK_BROKER_AUTH_TOKEN=

## Integrated runner API
## Set RUNNER_API_BASE_URL to a public tunnel URL when remote runners cannot
## reach BASE_URL. If unset, it defaults to BASE_URL.
# RUNNER_API_BASE_URL=
# RUNNER_ACTIVE_LOG_FS_PATH=/var/lib/superplane/active-runner-logs
## During a volume migration, list old paths so running tasks remain readable.
# RUNNER_ACTIVE_LOG_FS_FALLBACK_PATHS=/var/lib/superplane/old-active-runner-logs
# START_RUNNER_API=no
# START_RUNNER_LOG_COMPACTOR=no
# START_RUNNER_CLEANUP_WORKER=no

## Fleet Manager
## The local Fleet Manager creates its development token after owner setup.
## Set this only to use an existing installation administrator personal token.
# INSTALLATION_ADMIN_TOKEN=

## Hosted credit billing (Polar)
## Leave blank for self-hosted.
## Use an organization access token (OAT), not a personal token.
## Scopes: checkouts:write, customers:write, products:read, customer_sessions:write,
## orders:read, subscriptions:read, members:read, webhooks:read, webhooks:write
## webhooks:read and webhooks:write are required for Installation Admin Polar Webhooks.
## Sandbox and production tokens are not interchangeable.
## Set POLAR_ENVIRONMENT=production for SuperPlane Cloud. Default is sandbox.
## Webhook URL (absolute, no redirect): {BASE_URL}/api/v1/polar/webhooks
## Polar events: order.paid, order.refunded, subscription.created,
## subscription.updated, subscription.active, subscription.canceled.
## Credit packs: Polar product metadata superplane_credit_pack=true, fixed price.
## Business subscription: set POLAR_BUSINESS_PRODUCT_ID to the recurring
## Business product id. Leave empty to hide Subscribe checkout.
## Polar tax uses the proxy client IP (CF-Connecting-IP, True-Client-IP, X-Real-IP,
## or the right-most X-Forwarded-For hop). SuperPlane ignores a client-supplied IP body field.
## SuperPlane creates one Polar team customer per organization (external_id = org UUID).
## Polar owner email is the signed-in user. Polar receipts go to that address.
## SuperPlane does not set a Polar customer email. Polar members may share an email
## across organizations. Polar customer emails cannot.
## SuperPlane pins the Polar API version in code. Set POLAR_API_VERSION only to
## test another version in sandbox. Set the same API version on the Polar webhook
## endpoint.
# POLAR_ACCESS_TOKEN=
# POLAR_ENVIRONMENT=sandbox
# POLAR_WEBHOOK_SECRET=
# POLAR_BUSINESS_PRODUCT_ID=
# POLAR_API_VERSION=

## Enterprise license
##
## Leave SUPERPLANE_LICENSE_PATH empty to install the license in the
## installation admin page. When you set it, the file is the only license
## source and administrators cannot change the license in the UI.
## SuperPlane verifies the license offline. It downloads signed updates to
## its trusted keys; set SUPERPLANE_LICENSE_KEYS_URL=none to turn that off.
# SUPERPLANE_LICENSE_PATH=
# SUPERPLANE_LICENSE_KEYS_URL=
##
## Development only: set this to false to test Community mode.
# SUPERPLANE_LICENSE_DEV_ENTERPRISE=false

## Public SuperPlane GitHub App (SaaS / Factories)
##
## SuperPlane Cloud holds these values. Local factory onboarding also
## needs them. Without a complete set, SuperPlane blocks /onboarding
## and new workspace setup.
##
## Local setup: create a public GitHub App on a stable tunnel, then
## copy the values below. Do not commit real secrets. Full steps:
## docs/contributing/connecting-to-3rdparty-services-from-development.md
##
## When they are set and an organization has the factories feature,
## new GitHub connections install this app instead of creating one
## from a manifest.
##
## On the GitHub App, set:
##   Setup URL:          {BASE_URL}/api/v1/github/app/setup
##   Redirect on update: enabled
##   Webhook URL:        {WEBHOOKS_BASE_URL}/api/v1/github/app/webhook
##   User authorization: disabled
##   Member webhook:     enabled
# SUPERPLANE_GITHUB_APP_ID=
# SUPERPLANE_GITHUB_APP_SLUG=
# SUPERPLANE_GITHUB_APP_PRIVATE_KEY=
# SUPERPLANE_GITHUB_APP_WEBHOOK_SECRET=

## GitHub OAuth App for account identity. Set its callback URL to:
##   {BASE_URL}/auth/github/callback
## SuperPlane requests exactly user:email. This token is not used for GitHub
## App installations, repository access, collaborators, or automation.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

## Bitbucket Cloud OAuth consumer for account linking. This is not a sign-in
## method. Set the callback URL to:
##   {BASE_URL}/auth/bitbucket/callback
## SuperPlane requests the account scope only. It stores the account UUID and
## nickname. It does not store the OAuth token.
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

## SuperPlane public Sentry app
##
## Factory Sentry intake installs this app so SuperPlane can read issues
## and receive issue webhooks. Cloud holds these values. Local development
## can create a public Sentry app on a stable tunnel. Full steps:
## docs/contributing/connecting-to-3rdparty-services-from-development.md
##
## When they are set, new Sentry connections install this app instead of
## asking for a personal token and an internal integration.
##
## On the Sentry app, set:
##   Redirect URL: {BASE_URL}/api/v1/sentry/app/setup
##   Webhook URL:  {WEBHOOKS_BASE_URL}/api/v1/sentry/app/webhook
##   Events:       issue
# SUPERPLANE_SENTRY_APP_SLUG=
# SUPERPLANE_SENTRY_APP_CLIENT_ID=
# SUPERPLANE_SENTRY_APP_CLIENT_SECRET=
# Optional. When set, SuperPlane reads the public app and does not mark a
# connection ready unless the webhook URL and the issue event match.
# SUPERPLANE_SENTRY_APP_API_TOKEN=

## SuperPlane Jira OAuth 2.0 (3LO) app
##
## SuperPlane Cloud holds these values. Local Jira connect also needs them.
## When both are set, Connect uses this app and skips Client ID and Client Secret.
## Do not commit real secrets. Register the callback URL:
##   {BASE_URL}/api/v1/jira/oauth/callback
# SUPERPLANE_JIRA_OAUTH_CLIENT_ID=
# SUPERPLANE_JIRA_OAUTH_CLIENT_SECRET=

## SuperPlane Linear OAuth application
##
## When both are set, Connect authorizes this public app.
## When either is empty, Connect asks for a Client ID and a Client Secret.
## Do not commit real secrets. On the Linear OAuth application, set:
##   Callback URL: {BASE_URL}/api/v1/linear/oauth/callback
##   Scopes: read, write, admin
# SUPERPLANE_LINEAR_OAUTH_CLIENT_ID=
# SUPERPLANE_LINEAR_OAUTH_CLIENT_SECRET=

## Platform blob storage
##
## Development and test use filesystem. Other environments use s3 or gcs.
## s3 uses the AWS credential chain. Set the bucket and region.
# BLOB_STORAGE_PROVIDER=filesystem
# BLOB_STORAGE_LOCAL_PATH=/var/lib/superplane/blobs
# BLOB_STORAGE_BUCKET=
# BLOB_STORAGE_REGION=
# BLOB_STORAGE_CREDENTIALS_FILE=
# BLOB_STORAGE_SIGNING_KEY=

## scripts/wait-for-app
##
## make dev.server sources `.env` through scripts/wait-for-app after starting
## the dev server, so these helper values can live here too.
# WAIT_FOR_APP_HOST=localhost
# WAIT_FOR_APP_TIMEOUT_SECONDS=60
# WAIT_FOR_APP_INTERVAL_SECONDS=2
